# ==============================================================================
# Learnova AI - Deployment Environment Variables
# ==============================================================================

# -----------------
# Backend (.NET 10 Web API)
# -----------------
# MongoDB Atlas Connection URI:
MONGODB_URI=mongodb+srv://admin:<db_password>@cluster0.e0f8l0h.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=AI_LMS

# JWT Configuration (Ensure a strong 256-bit key in production):
Jwt__Key=Learnova_Enterprise_Secret_Key_For_JWT_Authentication_2026_Secure!
Jwt__Issuer=AI-LMS
Jwt__Audience=AI-LMS-Users

# Google Gemini AI Key:
Gemini__ApiKey=YOUR_GEMINI_API_KEY
Gemini__Model=gemini-3.5-flash-lite

# ASP.NET Core Environment (Production or Development):
ASPNETCORE_ENVIRONMENT=Production

# -----------------
# Frontend (Vite + React)
# -----------------
# Set to your deployed backend URL:
VITE_API_URL=https://your-backend-api.onrender.com/api
